<Window x:Class="PicSlicer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PicSlicer"
        Title="PicSlicer" Height="700" Width="1000"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="ApplicationCommands.Open"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Click"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Click"/>
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く(_O)..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                <MenuItem Header="分割して保存(_S)..." InputGestureText="Ctrl+S" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="水平線を追加(_H)" InputGestureText="H" Click="Add_H_Click"/>
                <MenuItem Header="垂直線を追加(_V)" InputGestureText="V" Click="Add_V_Click"/>
                <MenuItem Header="選択中の線を削除(_D)" InputGestureText="Delete" Click="Remove_Selected_Click"/>
                <Separator/>
                <MenuItem Header="均等に分割(_G)..." Click="EvenGrid_Click"/>
                <MenuItem Header="すべての線を削除(_C)" Click="Clear_Click"/>
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="拡大" InputGestureText="Ctrl+ホイール" Click="ZoomIn_Click"/>
                <MenuItem Header="縮小" Click="ZoomOut_Click"/>
                <MenuItem Header="100%" Click="ZoomActual_Click"/>
                <MenuItem Header="全体を表示" Click="ZoomFit_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="開く" Click="Open_Click"/>
                <Button Content="分割して保存" Click="Save_Click"/>
                <Separator/>
                <Button Content="＋水平線" Click="Add_H_Click"/>
                <Button Content="＋垂直線" Click="Add_V_Click"/>
                <Button Content="均等分割..." Click="EvenGrid_Click"/>
                <Button Content="全消去" Click="Clear_Click"/>
                <Separator/>
                <Button Content="－" Width="24" Click="ZoomOut_Click"/>
                <TextBlock x:Name="ZoomText" Text="100%" Width="48" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="＋" Width="24" Click="ZoomIn_Click"/>
                <Button Content="全体" Click="ZoomFit_Click"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="ImageSizeText" Text="画像サイズ: -"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="CursorText" Text="カーソル: -" MinWidth="120"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="SliceText" Text="分割数: -"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Foreground="Gray"
                           Text="定規からドラッグで線を追加 / 線をドラッグで移動 / 画像の外へドラッグかDeleteで削除 / 矢印キーで1px移動"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="#F0F0F0"
                    BorderBrush="DimGray" BorderThickness="0,0,1,1"/>

            <local:RulerControl x:Name="TopRuler" Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal" Cursor="SizeWE" ClipToBounds="True"
                                MouseLeftButtonDown="TopRuler_MouseDown"/>

            <local:RulerControl x:Name="LeftRuler" Grid.Row="1" Grid.Column="0"
                                Orientation="Vertical" Cursor="SizeNS" ClipToBounds="True"
                                MouseLeftButtonDown="LeftRuler_MouseDown"/>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#808080"
                          ScrollChanged="Scroller_ScrollChanged"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel">

                <Canvas x:Name="ImageCanvas"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="Transparent"
                        MouseLeftButtonDown="ImageCanvas_MouseDown"
                        MouseMove="ImageCanvas_MouseMove"
                        MouseLeftButtonUp="ImageCanvas_MouseUp"
                        MouseLeave="ImageCanvas_MouseLeave">

                    <Image x:Name="PreviewImage" Stretch="Fill" IsHitTestVisible="False"/>
                    <Canvas x:Name="GuideCanvas" IsHitTestVisible="False"/>
                </Canvas>
            </ScrollViewer>

            <TextBlock x:Name="DropHint" Grid.Row="1" Grid.Column="1"
                       Text="ここに画像をドロップ、または［開く］"
                       Foreground="White" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</Window>
