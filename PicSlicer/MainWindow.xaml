<Window x:Class="HomeMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:HomeMenu"
        
        Title="Menu Sample" Height="450" Width="800">

    <DockPanel>
        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_ファイル">
                <MenuItem Header="_開く" Click="Open_Click"/>
                <MenuItem Header="_保存" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="_終了" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_表示">
                <MenuItem Header="縦ルーラー表示"
                          IsCheckable="True"
                          Click="VerticalToggleRuler_Click"/>
                <MenuItem Header="横ルーラー表示"
                          IsCheckable="True"
                          Click="HorizontalToggleRuler_Click"/>
            </MenuItem>
        </Menu>

        

        <Grid Background="LightGray">
            <syncfusion:SfDiagram x:Name="diagram"
                      Background="Transparent"/>
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   IsHitTestVisible="False"/>

            <Canvas x:Name="OverlayCanvas"
                    IsHitTestVisible="False"/>
        </Grid>

    </DockPanel>
</Window>