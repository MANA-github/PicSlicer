<Window x:Class="HomeMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:HomeMenu"
        
        Title="Menu Sample" Height="450" Width="800">

    <DockPanel>
        <Menu DockPanel.Dock="Top">

            <MenuItem Header="_ファイル">
                <MenuItem Header="_開く" Click="Open_Click"/>
                <MenuItem Header="_保存" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="_終了" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_編集">
                <MenuItem Header="_分割線の追加">
                    <MenuItem Header="_水平線">
                        <MenuItem Header="_追加" Click="Add_H_Click"/>
                        <MenuItem Header="_削除" Click="Remove_H_Click"/>
                    </MenuItem>
                    <MenuItem Header="_垂直線">
                        <MenuItem Header="_追加" Click="Add_V_Click"/>
                        <MenuItem Header="_削除" Click="Remove_V_Click"/>
                    </MenuItem>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="ImageSizeText" Text="画像サイズ: -"/>
            </StatusBarItem>
        </StatusBar>

        <Grid DockPanel.Dock="Top" Background="LightGray">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <syncfusion:SfDiagram x:Name="diagram"
                Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Background="Transparent"/>

            <Image x:Name="PreviewImage"
                
                Grid.Row="1"
                Grid.Column="1"
                Stretch="Uniform"
                IsHitTestVisible="False"/>

            <Canvas x:Name="OverlayCanvas"
                Grid.Row="1"
                Grid.Column="1"
                IsHitTestVisible="False"/>
            
            <Canvas x:Name="GuidLineCanvas"/>
        </Grid>

    </DockPanel>
</Window>